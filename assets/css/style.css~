:root {
  --ink: #172433;
  --muted: #607080;
  --navy: #17324d;
  --navy-2: #244a6a;
  --teal: #2d7772;
  --paper: #f7f8f6;
  --card: #ffffff;
  --line: #dbe2e7;
  --accent: #e8f1f0;
  --shadow: 0 18px 50px rgba(25, 48, 69, 0.10);
  --radius: 22px;
  --max: 1160px;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  color: var(--ink);
  background: var(--paper);
  font-family: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
  line-height: 1.7;
}

a { color: var(--navy-2); text-decoration-thickness: 1px; text-underline-offset: 3px; }
a:hover { color: var(--teal); }
img { max-width: 100%; display: block; }

.container { width: min(var(--max), calc(100% - 40px)); margin: 0 auto; }

.site-header {
  position: sticky;
  top: 0;
  z-index: 20;
  background: rgba(247, 248, 246, 0.93);
  backdrop-filter: blur(14px);
  border-bottom: 1px solid rgba(219, 226, 231, 0.85);
}

.nav {
  min-height: 74px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}

.brand {
  font-weight: 760;
  letter-spacing: 0.01em;
  color: var(--navy);
  text-decoration: none;
  white-space: nowrap;
}

.nav-links { display: flex; align-items: center; gap: 24px; font-size: 0.95rem; }
.nav-links a { text-decoration: none; color: var(--ink); }
.nav-links a:hover, .nav-links a[aria-current="page"] { color: var(--teal); }

.hero {
  padding: 84px 0 68px;
  background:
    radial-gradient(circle at 78% 22%, rgba(45,119,114,.10), transparent 26%),
    linear-gradient(180deg, #fbfcfa 0%, #f7f8f6 100%);
  overflow: hidden;
}

.hero-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.25fr) minmax(320px, .75fr);
  align-items: center;
  gap: 72px;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 18px;
  color: var(--teal);
  font-weight: 720;
  font-size: .88rem;
  letter-spacing: .12em;
  text-transform: uppercase;
}

.hero h1, .page-hero h1 {
  margin: 0;
  color: var(--navy);
  font-family: Georgia, "Times New Roman", serif;
  font-weight: 600;
  letter-spacing: -0.03em;
}

.hero h1 { font-size: clamp(3rem, 6vw, 5.2rem); line-height: 1; }
.hero .subtitle {
  margin: 24px 0 0;
  max-width: 760px;
  font-size: clamp(1.18rem, 2vw, 1.52rem);
  color: #34485b;
  line-height: 1.55;
}
.hero .affiliation { margin-top: 14px; color: var(--muted); font-size: 1.03rem; }

.button-row { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 46px;
  padding: 0 18px;
  border-radius: 999px;
  border: 1px solid var(--navy);
  text-decoration: none;
  font-weight: 700;
  transition: transform .18s ease, box-shadow .18s ease, background .18s ease;
}
.button.primary { background: var(--navy); color: white; }
.button.secondary { background: white; color: var(--navy); }
.button:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(23,50,77,.10); }

.portrait-wrap { position: relative; }
.portrait-wrap::before {
  content: "";
  position: absolute;
  width: 72%; height: 72%;
  right: -10%; bottom: -8%;
  border-radius: 42% 58% 50% 50%;
  background: var(--accent);
  z-index: 0;
}
.portrait {
  position: relative;
  z-index: 1;
  width: min(100%, 390px);
  margin-left: auto;
  aspect-ratio: 4 / 5;
  object-fit: cover;
  object-position: 50% 36%;
  border-radius: 30px;
  box-shadow: var(--shadow);
}

.section { padding: 80px 0; }
.section.alt { background: #eef3f3; }
.section-head { display: flex; justify-content: space-between; gap: 24px; align-items: end; margin-bottom: 34px; }
.section-head h2, .content h2 {
  margin: 0;
  color: var(--navy);
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 600;
  line-height: 1.15;
}
.section-head p { margin: 0; color: var(--muted); max-width: 630px; }

.cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
.card {
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 28px;
  box-shadow: 0 10px 32px rgba(23,50,77,.05);
}
.card h3 { margin: 4px 0 10px; color: var(--navy); font-size: 1.18rem; }
.card p { margin: 0; color: var(--muted); }
.card .kicker { color: var(--teal); font-size: .8rem; font-weight: 760; letter-spacing: .1em; text-transform: uppercase; }

.flow {
  margin-top: 32px;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px;
}
.flow-step {
  position: relative;
  background: #fff;
  border: 1px solid var(--line);
  border-radius: 18px;
  padding: 22px;
  min-height: 154px;
}
.flow-step:not(:last-child)::after {
  content: "→";
  position: absolute;
  right: -18px;
  top: 50%;
  transform: translateY(-50%);
  color: var(--teal);
  font-weight: 800;
  font-size: 1.45rem;
  z-index: 2;
}
.flow-step strong { display: block; color: var(--navy); margin-bottom: 8px; }
.flow-step span { color: var(--muted); font-size: .94rem; }

.pub-list, .timeline { display: grid; gap: 16px; }
.pub, .timeline-item {
  background: white;
  border: 1px solid var(--line);
  border-radius: 18px;
  padding: 22px 24px;
}
.pub-title { color: var(--navy); font-weight: 700; }
.pub-meta { margin-top: 6px; color: var(--muted); font-size: .95rem; }

.split { display: grid; grid-template-columns: 1fr 1fr; gap: 34px; align-items: start; }
.note {
  background: var(--accent);
  border-left: 4px solid var(--teal);
  padding: 22px 24px;
  border-radius: 0 16px 16px 0;
}

.page-hero { padding: 72px 0 42px; background: #fbfcfa; border-bottom: 1px solid var(--line); }
.page-hero h1 { font-size: clamp(2.8rem, 6vw, 5rem); }
.page-hero p { max-width: 820px; color: var(--muted); font-size: 1.15rem; margin-top: 18px; }
.content { padding: 64px 0 88px; }
.content h2 { font-size: 2.15rem; margin-top: 54px; margin-bottom: 18px; }
.content h2:first-child { margin-top: 0; }
.content h3 { color: var(--navy); margin-top: 32px; }
.content p, .content li { max-width: 920px; }
.content ul { padding-left: 1.25rem; }

.funding-grid { display: grid; gap: 16px; }
.funding-item { border-left: 3px solid var(--teal); background: white; padding: 18px 20px; border-radius: 0 14px 14px 0; }
.funding-item strong { color: var(--navy); }

.contact-box {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 26px;
  background: var(--navy);
  color: white;
  border-radius: 24px;
  padding: 34px;
}
.contact-box h2 { color: white; margin: 0 0 10px; }
.contact-box a { color: #d8efec; }
.contact-box p { color: #d9e2ea; margin: 5px 0; }

.site-footer { border-top: 1px solid var(--line); padding: 34px 0 46px; color: var(--muted); font-size: .92rem; }
.footer-row { display: flex; justify-content: space-between; gap: 22px; flex-wrap: wrap; }

.menu-toggle { display: none; }

@media (max-width: 900px) {
  .hero-grid, .split, .contact-box { grid-template-columns: 1fr; }
  .hero-grid { gap: 40px; }
  .portrait { margin: 0; width: min(82vw, 430px); }
  .cards { grid-template-columns: 1fr; }
  .flow { grid-template-columns: 1fr 1fr; }
  .flow-step:nth-child(2)::after { display: none; }
  .nav-links { gap: 15px; font-size: .9rem; }
}

@media (max-width: 700px) {
  .container { width: min(100% - 28px, var(--max)); }
  .site-header { position: static; }
  .nav { flex-wrap: wrap; padding: 16px 0; }
  .menu-toggle {
    display: inline-flex;
    margin-left: auto;
    border: 1px solid var(--line);
    background: white;
    border-radius: 10px;
    padding: 8px 11px;
    color: var(--navy);
    font-weight: 700;
  }
  .nav-links { display: none; width: 100%; flex-direction: column; align-items: flex-start; padding: 10px 0 6px; }
  .nav-links.open { display: flex; }
  .hero { padding-top: 52px; }
  .hero h1 { font-size: 3.1rem; }
  .section { padding: 60px 0; }
  .section-head { flex-direction: column; align-items: flex-start; }
  .flow { grid-template-columns: 1fr; }
  .flow-step:not(:last-child)::after { content: "↓"; right: 50%; top: auto; bottom: -24px; transform: translateX(50%); }
  .flow-step:nth-child(2)::after { display: block; }
}
